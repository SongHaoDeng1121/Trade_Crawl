# Local database (never commit the generated database file)
OUTREACH_DB=data/outreach.sqlite3

# LLM configuration
USE_LLM=0
LLM_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Target market and your company profile
TARGET_REGION=
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_BUSINESS_SUMMARY=
COMPANY_FACEBOOK_URL=
COMPANY_EXTRA_INFO=

# Email identity and SMTP credentials
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_CC=
MAIL_BCC=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# Conservative sending defaults
SEND_DELAY_SECONDS=800
SEND_DAILY_LIMIT=100

# Optional Google Places discovery
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_REGION_CODE=
GOOGLE_PLACES_LANGUAGE_CODE=en
